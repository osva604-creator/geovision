# Safe default: no external DJI calls.
DJI_GATEWAY_MODE=disabled

# Comma-separated allow-list. Do not use *.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Development/tests only. Production must use a valid bearer token.
AUTH_MODE=off

# JWT auth example for non-production validation.
# AUTH_MODE=oidc-jwt
# AUTH_JWT_ISSUER=https://issuer.example
# AUTH_JWT_AUDIENCE=geovision-gateway
# AUTH_JWT_HS256_SECRET=replace-with-a-secret-from-secret-manager

MAX_JSON_BODY_BYTES=1048576
MAX_KMZ_BYTES=26214400

# Reserved future mode. Do not configure real endpoints until DJI provides
# official Smart Farm Ecosystem documentation.
# DJI_GATEWAY_MODE=smartfarm

# Mock mode for local end-to-end task-draft testing without contacting DJI.
# DJI_GATEWAY_MODE=smartfarm-mock

# Legacy compatibility only. Not compatible with Agras T70/T70P SmartFarm.
# DJI_GATEWAY_MODE=flighthub-legacy
# DJI_FLIGHTHUB_USER_TOKEN=
# DJI_FLIGHTHUB_PROJECT_UUID=
# DJI_FLIGHTHUB_BASE_URL=https://es-flight-api-us.djigate.com
# DJI_FLIGHTHUB_API_PREFIX=/openapi/v0.1
# DJI_FLIGHTHUB_LANGUAGE=en
# DJI_STORAGE_URL_STYLE=virtual
