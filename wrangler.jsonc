{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geovision",
  "account_id": "12a7e7f8710c2fe571714ecfe0716614",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026091701",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "DJI_RATE_LIMITER",
      "namespace_id": "2026091702",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
